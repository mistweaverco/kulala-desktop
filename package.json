{
  "name": "kulala-desktop",
  "version": "0.0.0",
  "description": "A minimal REST-Client GUI for Mac, Linux and Windows. It allows you to make HTTP requests via `.http` files.",
  "homepage": "https://kulala.app",
  "license": "MIT",
  "author": {
    "name": "Marco Kellershoff",
    "email": "marco@kellershoff.net"
  },
  "main": "./out/main/index.mjs",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck-node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm run typecheck-node && pnpm run svelte-check",
    "start": "electron-vite preview",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "fetch-kulala-core": "./scripts/fetch-kulala-core.sh",
    "build-unpack": "npm run build && TARGET_PLATFORM=${TARGET_PLATFORM:-linux} ./scripts/fetch-kulala-core.sh && electron-builder --dir",
    "build-windows": "VERSION=${VERSION:-$(node -p \"require('./package.json').version\")} TARGET_PLATFORM=windows ./scripts/build.sh",
    "build-macos": "VERSION=${VERSION:-$(node -p \"require('./package.json').version\")} TARGET_PLATFORM=macos PLATFORM=macos ./scripts/build.sh",
    "build-linux": "VERSION=${VERSION:-$(node -p \"require('./package.json').version\")} TARGET_PLATFORM=linux PLATFORM=linux ./scripts/build.sh",
    "build-linux-arm64": "VERSION=${VERSION:-$(node -p \"require('./package.json').version\")} TARGET_PLATFORM=linux-arm64 PLATFORM=linux-arm64 ./scripts/build.sh",
    "build-arch-local": "VERSION=0.0.0 TARGET_PLATFORM=arch-local ./scripts/build.sh",
    "build-and-install-arch-local": "VERSION=0.0.0 TARGET_PLATFORM=arch-local ./scripts/build.sh && ./scripts/arch-install-local-build.sh",
    "node-packages-update": "ncu -u",
    "node-packages-upgrade": "ncu -u && npm install",
    "translations": "typesafe-i18n --no-watch",
    "translations-watch": "typesafe-i18n",
    "install:electron": "pnpm exec node node_modules/electron/install.js"
  },
  "desktopName": "Kulala Desktop",
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "electron-settings": "4.0.4",
    "electron-updater": "6.8.9",
    "sqlite3": "6.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@floating-ui/dom": "1.7.6",
    "@fortawesome/fontawesome-free": "7.3.0",
    "@mistweaverco/electron-notarize-async": "0.0.4",
    "@mistweaverco/kulala-fmt": "4.5.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/bun": "1.3.14",
    "dotenv": "17.4.2",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.4",
    "electron-vite": "5.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-svelte": "3.20.0",
    "graphql": "17.0.2",
    "kit-monorepo": "github:sveltejs/kit",
    "melt": "0.44.0",
    "monaco-editor": "0.55.1",
    "monaco-graphql": "1.8.0",
    "node-gyp": "13.0.1",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-awesome-color-picker": "4.1.3",
    "svelte-check": "4.7.2",
    "tailwindcss": "4.3.2",
    "tslib": "2.8.1",
    "typesafe-i18n": "5.27.1",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  }
}
